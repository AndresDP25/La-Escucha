# ============================================================================
# Social Listening Dashboard - Variables de entorno (plantilla)
# Copiar a .env y completar. NUNCA commitear el archivo .env real.
# ============================================================================

# --- Entorno de ejecucion ---
NODE_ENV=development

# --- Servidor HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE?schema=public
DATABASE_URL=postgresql://sld:sld@localhost:5436/social_listening?schema=public

# --- Autenticacion (JWT) ---
# Clave para firmar tokens de sesion de los usuarios del sistema.
# Generar una aleatoria y larga en produccion.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# --- Anonimizacion / Privacidad ---
# Sal (pepper) global usada junto con la sal por-tenant para pseudonimizar
# usuarios de redes sociales. Debe mantenerse secreta y estable.
ANONYMIZATION_PEPPER=cambiar-por-un-pepper-largo-y-aleatorio

# --- Cola de trabajo (pg-boss usa la misma DATABASE_URL) ---
# Schema dedicado dentro de Postgres para las tablas de la cola.
QUEUE_SCHEMA=pgboss

# --- Integracion con LLM (opcional, para la Fase futura de IA real) ---
# Si esta vacio, el sistema usa el clasificador por diccionario/regex.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# --- Apify (busqueda manual de Instagram) ---
# Token de la cuenta. Cada clic corta solo a 0.05 USD.
APIFY_TOKEN=
