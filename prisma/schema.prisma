// ============================================================================
// Esquema de datos - Social Listening Dashboard
//
// Principios de diseno:
//  - MULTITENANCY: todo registro de dominio cuelga de un Tenant (municipio) via
//    `tenantId`. Nunca se consultan datos sin filtrar por tenant.
//  - FLEXIBILIDAD + CONSULTABILIDAD: el payload crudo de Apify se guarda tal cual
//    en columnas Json (`rawPayload` / `raw`), mientras que los campos normalizados
//    quedan tipados e indexados para el dashboard.
//  - IDEMPOTENCIA: `externalId` unico por tenant evita duplicados ante reintentos.
//  - PRIVACIDAD: el identificador del autor de redes se guarda pseudonimizado
//    (`authorHash`) o se descarta por completo si el comentario es sensible.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enumeraciones
// ----------------------------------------------------------------------------

/// Roles de los usuarios del SISTEMA (no de las redes sociales).
enum Role {
  SUPER_ADMIN // Administra todos los municipios (cross-tenant).
  ADMIN // Administra la configuracion de SU municipio.
  OPERATOR // Opera: dispara scrapings, revisa y reclasifica.
  VIEWER // Solo lectura del dashboard.
}

/// Tipo de objetivo de scraping dentro de Instagram.
enum TargetType {
  ACCOUNT // Cuenta/usuario, ej. "@sanfernandomuni"
  HASHTAG // Hashtag, ej. "#Virreyes"
  LOCATION // Ubicacion / place id
}

/// Categoria tematica de un comentario.
enum Category {
  SECURITY // Seguridad (municipio)
  PUBLIC_WORKS // Obras Publicas (municipio)
  HEALTH // Salud (municipio)
  POLITICS // Politico / Militancia (contenido potencialmente sensible)
  SUPPORT // Apoyo a la figura (persona)
  ENGAGEMENT // Pedido de participar / militar
  ATTACK // Critica o ataque
  OTHER // Sin categoria / otros
}

/// Como se interpreta el patron de una keyword.
enum MatchType {
  LITERAL // Coincidencia por substring normalizado.
  REGEX // Expresion regular.
}

/// Analisis de sentimiento del comentario.
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/// Estado del ciclo de vida de un evento de ingesta.
enum IngestionStatus {
  RECEIVED // Recibido y persistido crudo; pendiente de procesar.
  PROCESSING // Tomado por el worker.
  PROCESSED // Procesado con exito.
  ERROR // Fallo durante el procesamiento (ver campo `error`).
}

/// De donde salio una cuenta candidata a monitoreo.
enum DiscoveryReason {
  COMMENT_AUTHOR
  CAPTION_MENTION
  TAGGED_USER
  COMMENT_MENTION
}

/// Estado en la lista paralela (watchlist). No se scrapea hasta WATCHING.
enum WatchlistStatus {
  PENDING
  WATCHING
  IGNORED
}

/// Columna de la pizarra de tareas.
enum TaskStatus {
  TODO
  DOING
  DONE
}

// ----------------------------------------------------------------------------
// Tenant (Municipio) - raiz de la multitenancy
// ----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  /// Nombre visible, ej. "Municipio de San Fernando".
  name      String
  /// Identificador corto y unico, ej. "san-fernando".
  slug      String   @unique
  /// Perfil de Instagram de esta cuenta. Buscar trae posts solo de este usuario.
  instagramHandle String? @map("instagram_handle")
  /// Usuario de Twitter/X. Buscar en esa pestaña trae tuits y respuestas.
  twitterHandle String? @map("twitter_handle")
  /// Secreto compartido para validar la firma HMAC de los webhooks de este tenant.
  webhookSecret String @map("webhook_secret")
  /// Sal especifica del tenant usada para pseudonimizar autores de redes.
  anonymizationSalt String @map("anonymization_salt")
  isActive  Boolean  @default(true) @map("is_active")
  /// Cuenta nuestra: desde acá se puede publicar y contestar como ella.
  isOwned   Boolean  @default(false) @map("is_owned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  scrapeTargets   ScrapeTarget[]
  keywordConfigs  KeywordConfig[]
  ingestionEvents IngestionEvent[]
  posts           Post[]
  comments        Comment[]
  watchlist       WatchlistAccount[]
  ecosystems      EcosystemMember[]

  @@map("tenants")
}

// ----------------------------------------------------------------------------
// Ecosystem (grupo de cuentas que se escuchan juntas)
// ----------------------------------------------------------------------------

model Ecosystem {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members EcosystemMember[]
  tasks   Task[]

  @@map("ecosystems")
}

model EcosystemMember {
  ecosystemId String @map("ecosystem_id")
  tenantId    String @map("tenant_id")

  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([ecosystemId, tenantId])
  @@index([tenantId])
  @@map("ecosystem_members")
}

// ----------------------------------------------------------------------------
// User (usuario del sistema)
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  /// Tenant al que pertenece. Es NULL unicamente para el rol SUPER_ADMIN,
  /// que opera por encima de todos los municipios.
  tenantId     String?  @map("tenant_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  /// Clave de Apify de esta persona, cifrada. Nunca se devuelve al navegador.
  apifyToken   String?  @map("apify_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ----------------------------------------------------------------------------
// ScrapeTarget (que scrapea cada municipio)
// ----------------------------------------------------------------------------

model ScrapeTarget {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  type      TargetType
  /// Valor del objetivo, ej. "@sanfernandomuni", "#Virreyes".
  value     String
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
  @@index([tenantId])
  @@map("scrape_targets")
}

// ----------------------------------------------------------------------------
// WatchlistAccount (cuentas descubiertas; Eze: lista paralela)
// ----------------------------------------------------------------------------

model WatchlistAccount {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  /// instagram o twitter. Las referencias de una red no se mezclan con la otra.
  network   String          @default("instagram")
  /// Username, sin @, en minusculas.
  username  String
  reason    DiscoveryReason
  status    WatchlistStatus @default(PENDING)
  /// Id externo del post donde se vio por ultima vez.
  lastPostExternalId String? @map("last_post_external_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, network, username])
  @@index([tenantId, status])
  @@map("watchlist_accounts")
}

// ----------------------------------------------------------------------------
// Task (pizarra del ecosistema: pendiente, en curso, finalizada)
// ----------------------------------------------------------------------------

model Task {
  id          String     @id @default(uuid())
  ecosystemId String     @map("ecosystem_id")
  title       String
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)

  @@index([ecosystemId, status, position])
  @@map("tasks")
}

// ----------------------------------------------------------------------------
// KeywordConfig (diccionario de clasificacion dinamico por municipio)
// ----------------------------------------------------------------------------

model KeywordConfig {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  category  Category
  /// Patron a buscar. Si matchType = LITERAL es texto plano (ej. "bache");
  /// si es REGEX, una expresion regular valida.
  pattern   String
  matchType MatchType @default(LITERAL) @map("match_type")
  /// Peso para desempatar cuando varias categorias coinciden (mayor gana).
  weight    Int       @default(1)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("keyword_configs")
}

// ----------------------------------------------------------------------------
// IngestionEvent (payload crudo recibido del scraper externo)
// ----------------------------------------------------------------------------

model IngestionEvent {
  id         String          @id @default(uuid())
  tenantId   String          @map("tenant_id")
  /// Origen del dato, ej. "apify".
  source     String          @default("apify")
  /// Identificador del lote/corrida provisto por el origen (idempotencia).
  externalId String          @map("external_id")
  /// Payload JSON crudo, sin transformar.
  rawPayload Json            @map("raw_payload")
  status     IngestionStatus @default(RECEIVED)
  /// Mensaje de error si status = ERROR.
  error      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  processedAt DateTime?      @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalId])
  @@index([tenantId, status])
  @@map("ingestion_events")
}

// ----------------------------------------------------------------------------
// Post (publicacion de Instagram normalizada)
// ----------------------------------------------------------------------------

model Post {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  network     String    @default("instagram")
  /// Id del post en la red social (idempotencia por tenant+red).
  externalId  String    @map("external_id")
  url         String?
  /// Referencia pseudonimizada del autor del post (cuenta publica).
  authorRef   String?   @map("author_ref")
  caption     String?
  publishedAt DateTime? @map("published_at")
  /// Datos crudos del post tal como llegaron.
  raw         Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([tenantId, network, externalId])
  @@index([tenantId, publishedAt])
  @@map("posts")
}

// ----------------------------------------------------------------------------
// Comment (comentario normalizado, clasificado y anonimizado)
// ----------------------------------------------------------------------------

model Comment {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  postId     String  @map("post_id")
  /// Id del comentario en la red social (idempotencia por tenant).
  externalId String  @map("external_id")

  // --- Identidad del autor (PRIVACIDAD) ---
  /// Pseudonimo del autor: HMAC(username, salt_tenant + pepper).
  /// Es NULL cuando el comentario fue anonimizado de forma irreversible.
  authorHash   String? @map("author_hash")
  /// Marca si el comentario fue anonimizado (contenido sensible / politico).
  isAnonymized Boolean @default(false) @map("is_anonymized")
  /// Marca si el comentario fue clasificado como sensible.
  isSensitive  Boolean @default(false) @map("is_sensitive")

  // --- Contenido ---
  /// Texto original. Se descarta (NULL) si el comentario es anonimizado.
  rawText   String? @map("raw_text")
  /// Texto limpio/normalizado (sin stop-words ni emojis), apto para analisis.
  cleanText String  @map("clean_text")
  /// Emojis aislados del texto original.
  emojis    String[]

  // --- Enriquecimiento NLP ---
  category  Category  @default(OTHER)
  sentiment Sentiment @default(NEUTRAL)

  // --- Metricas ---
  likeCount   Int?      @map("like_count")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, category, sentiment])
  @@index([tenantId, publishedAt])
  @@map("comments")
}
